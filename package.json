{
  "name": "sikat-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Sikat ERP — frontend-only UI prototype built on the Sikat design system.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "electron:dev": "node electron/dev.mjs",
    "electron": "npm run build && electron .",
    "electron:dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@jasperlepardo/sikat-design-system": "^0.34.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.6.0",
    "electron-builder": "^26.5.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "build": {
    "appId": "ph.sikat.erp",
    "productName": "Sikat ERP",
    "files": [
      "dist/**",
      "electron/main.cjs",
      "package.json",
      "!node_modules/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
